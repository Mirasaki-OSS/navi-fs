{
  "name": "navi-fs",
  "version": "2.0.0-alpha.0",
  "description": "Transform your local files into a secure, powerful API. Stream, serve, and execute using simple configuration and REST-style access.",
  "main": "dist/src/index.js",
  "scripts": {
    "clean": "rimraf ./dist",
    "clean:full": "npm run clean; rimraf node_modules",
    "lint": "npx biome check",
    "lint:fix": "npx biome check --write",
    "lint:fix:unsafe": "npx biome check --write --unsafe",
    "prebuild": "npm run clean",
    "build": "tsc",
    "start": "NODE_ENV=production node dist/src/index.js >> logs/app.log 2>&1",
    "dev": "NODE_ENV=development tsx watch --include config.yaml src/index.ts",
    "pretest": "npm run build",
    "setup:linux": "npm install && cp config.example.yaml config.yaml",
    "setup:windows": "npm install && copy config.example.yaml config.yaml",
    "test": "mocha dist/test/**/*.js",
    "test:dev": "ts-mocha test/**/*.spec.ts -w --watch-files '**/*.ts'",
    "typecheck": "tsc --noEmit",
    "commit": "cz",
    "up": "npx npm-check-updates -u"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/archiver": "^8.0.0",
    "@types/body-parser": "^2.2.0",
    "@types/chai": "^5.2.3",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.11",
    "chai": "^6.3.0",
    "mocha": "^12.0.3",
    "pino-pretty": "^13.2.0",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "body-parser": "^2.4.0",
    "cls-rtracer": "^2.6.4",
    "compression": "^1.8.2",
    "express": "^5.3.0",
    "js-yaml": "^5.5.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limiter-flexible": "^11.6.1",
    "zod": "^4.6.7"
  }
}
